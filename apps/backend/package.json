{
  "name": "@logitland/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker for the Logitland relay: public API, delivery queue consumer and cron recovery",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "gen": "wrangler types --env-file .dev.vars.example",
    "build": "wrangler types --env-file .dev.vars.example --check && wrangler deploy --dry-run --outdir dist",
    "check": "wrangler types --env-file .dev.vars.example --check && tsc -p .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:e2e": "tsc -p test/e2e",
    "db:migrate:local": "wrangler d1 migrations apply logitland --local",
    "db:seed:local": "wrangler d1 execute logitland --local --file scripts/seed.sql"
  },
  "dependencies": {
    "@logitland/relay": "workspace:*",
    "@sentry/cloudflare": "^11.8.0"
  },
  "devDependencies": {
    "@logitland/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
