{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is local development and gets its own name, so a deploy without --env can't replace a live Worker.
  "name": "logitland-backend-dev",
  "main": "src/index.ts",
  // Not later than the workerd bundled with the pinned wrangler (1.20261001.1).
  "compatibility_date": "2026-10-01",
  // Sentry (@sentry/cloudflare) keeps each request's scope in AsyncLocalStorage.
  "compatibility_flags": ["nodejs_als"],

  // The top level is local development (`wrangler dev`, with .dev.vars). CI deploys `--env staging` and `--env production` (DEPLOY.md).
  // Never on workers.dev: the dashboard's API is a named entrypoint, and nothing else should be public by accident.
  "workers_dev": false,
  "preview_urls": false,
  // Invocation logs record "<Method> <URL>", and URLs carry claim codes, so they stay off. relay.log lines (console) are kept.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
  // Workers Cache serves repeat GETs of the docs (/auth.md, /skill.md, /v1/rules.md) without running the Worker (Cache-Control decides). It also
  // covers service-binding calls, and a hit skips the Worker's auth, so the dashboard's entrypoint is switched off.
  "cache": { "enabled": true },
  "exports": { "InternalApi": { "type": "worker", "cache": { "enabled": false } } },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logitland",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/relay/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "DiscordGateway" },
      { "name": "CHANNEL_SENDER", "class_name": "ChannelSender" },
      { "name": "AGENT_STREAM", "class_name": "AgentStream" },
      { "name": "SHOWCASE_LIVE", "class_name": "ShowcaseLive" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DiscordGateway", "ChannelSender"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentStream"] },
    { "tag": "v3", "new_sqlite_classes": ["ShowcaseLive"] },
  ],
  // The relay's copies of custom avatars, served at /v1/avatars/<sha256>-<copy>.<ext> (packages/relay/src/services/avatars.ts).
  "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "logitland-dev-avatars" }],
  "queues": {
    "producers": [{ "binding": "DELIVERIES", "queue": "logitland-deliveries" }],
    "consumers": [
      { "queue": "logitland-deliveries", "max_batch_size": 10, "max_concurrency": 10, "max_retries": 24, "dead_letter_queue": "logitland-deliveries-dlq" },
    ],
  },
  // Every minute: Gateway watchdog, held-message re-checks, stuck sends, re-fan-out of unfanned events, due deliveries.
  // Every 15 minutes: retention, raw-IP purge, rate-counter sweep, re-sealing after a key rotation.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PUBLIC_URL": "http://localhost:8787",
    "DASHBOARD_URL": "http://localhost:5173",
    "MODERATION_OUTAGE": "hold",
    "SENTRY_ENVIRONMENT": "development",
  },

  // Both environments share one hostname with the web app (#30 Q9): the web Worker owns it as a Custom Domain, and these
  // routes, which Cloudflare runs before a Custom Domain, send the relay's paths here. Keep them in step with PUBLIC_API in
  // packages/contracts/src/api.ts. Everything is repeated per environment on purpose: don't rely on what one inherits.
  // The D1 IDs are filled in by scripts/setup-deploy.sh; secrets come from the GitHub environment on every deploy (DEPLOY.md).
  "env": {
    "staging": {
      "name": "logitland-backend-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
      "cache": { "enabled": true },
      "exports": { "InternalApi": { "type": "worker", "cache": { "enabled": false } } },
      "routes": [
        { "pattern": "staging.logit.land/v1/*", "zone_name": "logit.land" },
        { "pattern": "staging.logit.land/mcp*", "zone_name": "logit.land" },
        { "pattern": "staging.logit.land/oauth2/*", "zone_name": "logit.land" },
        { "pattern": "staging.logit.land/agent/*", "zone_name": "logit.land" },
        { "pattern": "staging.logit.land/.well-known/oauth-*", "zone_name": "logit.land" },
        { "pattern": "staging.logit.land/auth.md", "zone_name": "logit.land" },
        { "pattern": "staging.logit.land/skill.md", "zone_name": "logit.land" },
      ],
      "vars": {
        "PUBLIC_URL": "https://staging.logit.land",
        "DASHBOARD_URL": "https://staging.logit.land",
        // logit.land but staging, where the Logan staging app's bot lives.
        "DISCORD_GUILD_ID": "1562476123131093042",
        "MODERATION_OUTAGE": "hold",
        "SENTRY_ENVIRONMENT": "staging",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "logitland-staging",
          "database_id": "e059fa37-1b9a-425d-bf95-27368bda0b67",
          "migrations_dir": "../../packages/relay/migrations",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "GATEWAY", "class_name": "DiscordGateway" },
          { "name": "CHANNEL_SENDER", "class_name": "ChannelSender" },
          { "name": "AGENT_STREAM", "class_name": "AgentStream" },
          { "name": "SHOWCASE_LIVE", "class_name": "ShowcaseLive" },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["DiscordGateway", "ChannelSender"] },
        { "tag": "v2", "new_sqlite_classes": ["AgentStream"] },
        { "tag": "v3", "new_sqlite_classes": ["ShowcaseLive"] },
      ],
      "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "logitland-staging-avatars" }],
      "queues": {
        "producers": [{ "binding": "DELIVERIES", "queue": "logitland-staging-deliveries" }],
        "consumers": [
          {
            "queue": "logitland-staging-deliveries",
            "max_batch_size": 10,
            "max_concurrency": 10,
            "max_retries": 24,
            "dead_letter_queue": "logitland-staging-deliveries-dlq",
          },
        ],
      },
      "triggers": { "crons": ["* * * * *"] },
    },
    "production": {
      "name": "logitland-backend",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
      "cache": { "enabled": true },
      "exports": { "InternalApi": { "type": "worker", "cache": { "enabled": false } } },
      "routes": [
        { "pattern": "logit.land/v1/*", "zone_name": "logit.land" },
        { "pattern": "logit.land/mcp*", "zone_name": "logit.land" },
        { "pattern": "logit.land/oauth2/*", "zone_name": "logit.land" },
        { "pattern": "logit.land/agent/*", "zone_name": "logit.land" },
        { "pattern": "logit.land/.well-known/oauth-*", "zone_name": "logit.land" },
        { "pattern": "logit.land/auth.md", "zone_name": "logit.land" },
        { "pattern": "logit.land/skill.md", "zone_name": "logit.land" },
      ],
      "vars": {
        "PUBLIC_URL": "https://logit.land",
        "DASHBOARD_URL": "https://logit.land",
        // The logitland server, where production's Logan lives.
        "DISCORD_GUILD_ID": "1561539052400934992",
        "MODERATION_OUTAGE": "hold",
        "SENTRY_ENVIRONMENT": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "logitland",
          "database_id": "c6997d7c-951f-4906-af6c-4e24a912c64c",
          "migrations_dir": "../../packages/relay/migrations",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "GATEWAY", "class_name": "DiscordGateway" },
          { "name": "CHANNEL_SENDER", "class_name": "ChannelSender" },
          { "name": "AGENT_STREAM", "class_name": "AgentStream" },
          { "name": "SHOWCASE_LIVE", "class_name": "ShowcaseLive" },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["DiscordGateway", "ChannelSender"] },
        { "tag": "v2", "new_sqlite_classes": ["AgentStream"] },
        { "tag": "v3", "new_sqlite_classes": ["ShowcaseLive"] },
      ],
      "r2_buckets": [{ "binding": "AVATARS", "bucket_name": "logitland-avatars" }],
      "queues": {
        "producers": [{ "binding": "DELIVERIES", "queue": "logitland-deliveries" }],
        "consumers": [
          { "queue": "logitland-deliveries", "max_batch_size": 10, "max_concurrency": 10, "max_retries": 24, "dead_letter_queue": "logitland-deliveries-dlq" },
        ],
      },
      "triggers": { "crons": ["* * * * *"] },
    },
  },
  // Secrets, pushed from the GitHub environment with each deploy: RELAY_SECRET_KEY, IP_HASH_KEY, INTERNAL_TOKEN,
  // DISCORD_BOT_TOKEN, DISCORD_APPLICATION_ID, DISCORD_PUBLIC_KEY, TYPESAFE_API_KEY, optionally SENTRY_DSN.
  // JEV_MODEL and BLOCKED_HOSTS are optional and set by hand (wrangler secret put). See DEPLOY.md.
}
