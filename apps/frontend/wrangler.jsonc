{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The top level is local development and gets its own name, so a deploy without --env production can't replace the live Worker.
  "name": "logitland-frontend-dev",
  // Not later than the workerd bundled with the pinned wrangler (1.20261001.1).
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  // Invocation logs record "<Method> <URL>", and the OAuth callback URL carries a code, so they stay off. console logs are kept.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Never on workers.dev: the dashboard is reached on its own hostname only.
  "workers_dev": false,
  "preview_urls": false,

  // BACKEND: the relay's internal API, a named entrypoint reachable only through this binding.
  // RELAY: the relay's public app (the mirror's /public API), reached without the public internet.
  "services": [
    { "binding": "BACKEND", "service": "logitland-backend-dev", "entrypoint": "InternalApi" },
    { "binding": "RELAY", "service": "logitland-backend-dev" },
  ],

  "vars": {
    // "fixtures" shows the example community and needs no backend. It only applies on a local PUBLIC_URL;
    // anywhere else the dashboard uses the relay through BACKEND.
    "DATA_SOURCE": "fixtures",
    "PUBLIC_URL": "http://localhost:5173",
    "RELAY_PUBLIC_URL": "http://localhost:8787",
    // Named on /privacy as who runs this site, and the address people write to about their data.
    "OPERATOR_NAME": "Logitland (local development)",
    "CONTACT_EMAIL": "privacy@example.invalid",
  },

  "env": {
    "production": {
      "name": "logitland-frontend",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true, "logs": { "invocation_logs": false } },
      "routes": [{ "pattern": "REPLACE.invalid", "custom_domain": true }],
      "services": [
        { "binding": "BACKEND", "service": "logitland-backend", "entrypoint": "InternalApi" },
        { "binding": "RELAY", "service": "logitland-backend" },
      ],
      "vars": {
        "DATA_SOURCE": "relay",
        "PUBLIC_URL": "https://REPLACE.invalid",
        "RELAY_PUBLIC_URL": "https://relay.REPLACE.invalid",
        "OPERATOR_NAME": "REPLACE with the name of whoever runs Logitland",
        "CONTACT_EMAIL": "REPLACE@REPLACE.invalid",
      },
    },
  },
  // Secrets (wrangler secret put --env production, or .dev.vars locally): SESSION_SECRET, INTERNAL_TOKEN,
  // DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET.
}
