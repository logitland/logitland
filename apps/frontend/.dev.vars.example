# Copy to .dev.vars. Never commit .dev.vars.
# At least 32 random characters (`openssl rand -base64 32` gives 44). Signs the session cookie. The site refuses to serve outside local development without it.
SESSION_SECRET=
# Must match apps/backend's INTERNAL_TOKEN. This example value is refused outside local development.
INTERNAL_TOKEN=dev-internal-token
# From the Discord Developer Portal (OAuth2). Leave empty to use the development sign-in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Local development only (pnpm dev:full sets it): "true" adds a sign-in by Discord user ID on a local PUBLIC_URL.
DEV_SIGN_IN=
