{
  "name": "@logitland/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SvelteKit marketing pages, owner dashboard and admin dashboard on Cloudflare Workers, built on shadcn-svelte",
  "scripts": {
    "dev": "vite dev --host --port 5174 --strictPort",
    "build": "wrangler types && vite build && cp -R ../docs/.svartz/vaults/docs/dist .svelte-kit/cloudflare/docs",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4174",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "gen": "wrangler types",
    "test": "vitest run"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@internationalized/date": "catalog:",
    "@logitland/contracts": "workspace:*",
    "@logitland/tokens": "workspace:*",
    "@logitland/ui": "workspace:*",
    "@lucide/svelte": "catalog:",
    "@mdream/js": "catalog:",
    "@shadcn-svelte/primitives": "catalog:",
    "@sveltejs/adapter-cloudflare": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "bits-ui": "catalog:",
    "cn": "catalog:",
    "embla-carousel-svelte": "catalog:",
    "formsnap": "catalog:",
    "layerchart": "catalog:",
    "mode-watcher": "catalog:",
    "paneforge": "catalog:",
    "shadcn-svelte": "catalog:",
    "shiki": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "svelte-sonner": "catalog:",
    "sveltekit-superforms": "catalog:",
    "tailwind-variants": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:ts6",
    "vaul-svelte": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "zod": "catalog:"
  }
}
