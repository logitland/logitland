{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The top level is local development and gets its own name, so a deploy without --env can't replace a live Worker.
  "name": "logitland-web-dev",
  // Not later than the workerd bundled with the pinned wrangler (1.20261001.1).
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "workers_dev": false,
  "preview_urls": false,
  // The relay's dashboard API: a named entrypoint, so it's reachable only through this binding. Locally, the relay runs
  // under `wrangler dev` (pnpm dev:full) and the binding finds it by name.
  "services": [{ "binding": "RELAY", "service": "logitland-backend-dev", "entrypoint": "InternalApi" }],
  // Sign-in goes to the fake Discord that pnpm dev:full starts.
  "vars": { "DISCORD_URL": "http://127.0.0.1:8790" },
  // Locally from .dev.vars (see .dev.vars.example); deployed, from the GitHub environment with each deploy (DEPLOY.md).
  "secrets": { "required": ["INTERNAL_TOKEN", "SESSION_SECRET", "DISCORD_CLIENT_ID", "DISCORD_CLIENT_SECRET"] },

  // Each environment owns its hostname as a Custom Domain (Cloudflare creates the DNS record); the backend's routes on the
  // same hostname take the relay's paths before they reach this Worker.
  "env": {
    "staging": {
      "name": "logitland-web-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.logit.land", "custom_domain": true }],
      "services": [{ "binding": "RELAY", "service": "logitland-backend-staging", "entrypoint": "InternalApi" }],
      "vars": { "DISCORD_URL": "https://discord.com" },
      "secrets": { "required": ["INTERNAL_TOKEN", "SESSION_SECRET", "DISCORD_CLIENT_ID", "DISCORD_CLIENT_SECRET"] },
    },
    "production": {
      "name": "logitland-web",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "logit.land", "custom_domain": true }],
      "services": [{ "binding": "RELAY", "service": "logitland-backend", "entrypoint": "InternalApi" }],
      "vars": { "DISCORD_URL": "https://discord.com" },
      "secrets": { "required": ["INTERNAL_TOKEN", "SESSION_SECRET", "DISCORD_CLIENT_ID", "DISCORD_CLIENT_SECRET"] },
    },
  },
}
