{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    // No noUncheckedIndexedAccess: shadcn-svelte's generated components aren't written for it, and they stay as the CLI writes them.
    "strict": true,
    // worker-configuration.d.ts imports the built _worker.js (wrangler's mainModule type); don't type-check that bundle.
    "checkJs": false,
    "types": ["$app/types", "./worker-configuration.d.ts"]
  },
  "include": ["src", "vite.config.ts"]
}
