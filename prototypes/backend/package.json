{
  "name": "@swarmcord/backend-prototype",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/demo.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "types": "wrangler types --include-runtime false --strict-vars false",
    "check": "tsc --noEmit && biome check src scripts",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "^26.6.5",
    "typescript": "7.0.2",
    "wrangler": "4.151.1"
  }
}
