{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".svelte-kit/output/**", ".svelte-kit/cloudflare/**"]
    },
    "check": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!.svelte-kit/**", "!dist/**"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "check:e2e": {
      "dependsOn": ["transit"]
    },
    "test:e2e": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "//#dev:setup": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["//#dev:setup"],
      "cache": false,
      "persistent": true
    }
  }
}
