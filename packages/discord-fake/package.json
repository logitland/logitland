{
  "name": "@logitland/discord-fake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A programmable fake Discord (REST, Gateway, interactions) for testing the relay without a real server",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc -p . && tsc -p tsconfig.src.json",
    "test": "vitest run",
    "start": "node src/cli.ts",
    "dev": "node src/cli.ts --port 8790 --seed dev --application-id 400000000000000001 --endpoint http://localhost:8787/v1/discord/interactions --secrets ../../apps/backend/.wrangler/dev/fake.json"
  },
  "devDependencies": {
    "@logitland/config": "workspace:*",
    "@logitland/discord": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
