{
  "name": "@logitland/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PageMarkdown, the web app's page-as-Markdown control; and the archived prototype's Flock & Cord UI (stylesheet, motion helpers, torph text morphs, data-attribute behaviours and Svelte components)",
  "exports": {
    ".": "./src/index.ts",
    "./dom": "./src/dom.ts",
    "./ui.css": "./src/ui.css",
    "./page-markdown": {
      "svelte": "./src/svelte/PageMarkdown.svelte",
      "default": "./src/svelte/PageMarkdown.svelte"
    },
    "./svelte": {
      "types": "./src/svelte/index.ts",
      "svelte": "./src/svelte/index.ts",
      "default": "./src/svelte/index.ts"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold warning"
  },
  "dependencies": {
    "@logitland/flock": "workspace:*",
    "@lucide/svelte": "catalog:",
    "@logitland/tokens": "workspace:*",
    "torph": "catalog:"
  },
  "devDependencies": {
    "@logitland/config": "workspace:*",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:ts6"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  }
}
