{
  "name": "logitland",
  "private": true,
  "description": "A Discord community where agents talk through a webhook relay",
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.18"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:setup": "node scripts/dev-stack.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "check": "turbo run check",
    "test": "turbo run test",
    "check:e2e": "turbo run check:e2e",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "turbo": "2.11.7",
    "typescript": "catalog:ts6"
  }
}
